#!/usr/bin/env bash
set -euo pipefail

ROM_NAME="Rolan's Curse II (USA).gb"

rc2t_print_help_message() {
    echo ""
    echo "Usage: $(basename "$0") <command>"
    echo ""
    echo "Commands:"
    echo "  dump-hex             Dump the contents in hexadecimal"
    echo "  check-hash           Check the hash"
    echo "  render-graphics | rg [start [end [WxH|output]]] [options]  Render ROM tiles (default: entire ROM)"
    echo "    --highlight-known  Shade documented graphics in blue, text in yellow, lookup or stat tables in green, and tilemaps, tables, and routines in purple"
    echo "    --compare          Compare input/ with the working hack; same bytes are green, different bytes grayscale"
    echo "    --stacked-glyphs   Render 16-byte tiles as two stacked 1bpp glyphs"
    echo "  render-text | rt     Decode the entire ROM into output/rom-text.txt as one string"
    echo "    --wrap             Wrap output every 64 characters with ROM addresses"
    echo "    --known-only       Render unknown or undefined bytes as underscores"
    echo "    --omit-sprites     Render known graphics bytes as percent signs"
    echo "  dump-text [rom-or-hex [output]]  Dump documented text ranges into output/known-text.txt"
    echo "  decompile | disassemble [rom [output]] [--start OFFSET] [--end OFFSET]  Disassemble a Game Boy ROM"
    echo "  recompile [assembly-file]  Assemble an input/ .asm file into output/<basename> (recompiled).gb"
    echo "  hack <subcommand>  Edit the working/ hack copy:"
    echo "    clear                             Delete the in-progress hack copy and hacks.txt"
    echo "    reset                             Replace the in-progress hack copy with a fresh copy of input/"
    echo "    finalize [tag]                    Copy the hack, IPS patch, and log to output/"
    echo "    swap-char-sprite <char1> <char2>  Swap two characters' sprites and POW portraits"
    echo "    dump-art <name|all>               Export title, character, or NPC art to working/<name>-art.png"
    echo "    inject-art <name|all>             Apply working/<name>-art.png to the in-progress hack"
    echo "    dump-stats [rom-or-hex]           Write character stat arrays to working/stats.txt"
    echo "    inject-stats                      Apply modified arrays from working/stats.txt"
}

_check_if_rom_exists() {
    if [ ! -f input/"$ROM_NAME" ]; then
        echo "Error: ROM file '$ROM_NAME' not found."
        exit 1
    fi
}

_get_hash() {
    sha256sum "input/$ROM_NAME" | awk '{print $1}'
}

##### MAIN #####

cd "$(dirname "$0")"

if [ $# -eq 0 ] || [ -z "$1" ]; then
    rc2t_print_help_message
    exit 1
fi

case "$1" in
    check-hash)
        _check_if_rom_exists
        _get_hash
        ;;

    dump-hex)
        _check_if_rom_exists
        xxd "input/$ROM_NAME" > "output/$ROM_NAME.hex"
        ;;

    render-graphics|rg)
        if [ "$#" -eq 1 ]; then
            python3 bin/render_graphics.py 0 0x20000 output/graphics.png
        elif [[ "$2" == --* ]]; then
            python3 bin/render_graphics.py 0 0x20000 output/graphics.png "${@:2}"
        elif [ "$#" -eq 2 ]; then
            python3 bin/render_graphics.py "$2" 0x20000 output/graphics.png
        elif [ "$#" -ge 3 ] && [[ "$3" =~ ^0*[1-9][0-9]*[xX][0-9]+$ ]]; then
            python3 bin/render_graphics.py "$2" 0x20000 output/graphics.png --tile-grid "$3" "${@:4}"
        elif [[ "$3" == --* ]]; then
            python3 bin/render_graphics.py "$2" 0x20000 output/graphics.png "${@:3}"
        elif [ "$#" -eq 3 ]; then
            python3 bin/render_graphics.py "$2" "$3" output/graphics.png
        elif [ "$#" -ge 4 ] && [[ "$4" == --* ]]; then
            python3 bin/render_graphics.py "$2" "$3" output/graphics.png "${@:4}"
        elif [ "$#" -ge 4 ] && [[ "$4" =~ ^0*[1-9][0-9]*[xX][0-9]+$ ]]; then
            python3 bin/render_graphics.py "$2" "$3" output/graphics.png --tile-grid "$4" "${@:5}"
        else
            python3 bin/render_graphics.py "${@:2}"
        fi
        ;;

    render-text|rt)
        python3 bin/render_text.py "${@:2}"
        ;;

    dump-text)
        python3 bin/dump_text.py "${@:2}"
        ;;

    decompile|disassemble)
        python3 bin/decompile_rom.py "${@:2}"
        ;;

    recompile)
        python3 bin/recompile_rom.py "${@:2}"
        ;;

    hack)
        python3 bin/hack_rom.py "${@:2}"
        ;;

    *)
        rc2t_print_help_message
        ;;
esac
